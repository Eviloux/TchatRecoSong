# =========================
# Backend environment file
# =========================
# Copie ce fichier en `.env` (jamais versionné) ou crée les variables sur Render.

# URL complète PostgreSQL fournie par Neon ou Render.
# Exemple : postgresql://user:password@host:5432/database?sslmode=require
# (⚠️ Retire `&channel_binding=require` de l'URL Neon : non supporté par la libpq de Render.)
DATABASE_URL=

# -- Alternative : champs individuels si tu n'as pas d'URL unique --
#DATABASE_HOST=
#DATABASE_PORT=5432
#DATABASE_NAME=
#DATABASE_USER=
#DATABASE_PASSWORD=
#DATABASE_SSLMODE=require

# Origines autorisées pour CORS (séparées par des virgules, sans / final)
CORS_ORIGINS=https://tchatrecosong-front.onrender.com

# Secret de signature des JWT admin. OBLIGATOIRE en production.
# Génère-le avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
ADMIN_JWT_SECRET=
# Durée de validité des tokens admin en minutes (12 h par défaut)
ADMIN_TOKEN_TTL_MINUTES=720

# Identifiants OAuth Google & Twitch
GOOGLE_CLIENT_ID=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaîne dont le badge « En live / Hors ligne » est affiché (défaut : music_oceane)
TWITCH_CHANNEL_LOGIN=music_oceane

# Comptes autorisés à accéder à l'administration (séparés par des virgules).
# Liste vide = connexion Google/Twitch refusée pour tout le monde.
ALLOWED_GOOGLE_EMAILS=
ALLOWED_TWITCH_LOGINS=

# Connexion e-mail / mot de passe (optionnelle)
ADMIN_PASSWORD_LOGIN_ENABLED=true
# Le compte par défaut n'est créé que si un mot de passe (ou son hash) est fourni.
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_NAME=
ADMIN_DEFAULT_PASSWORD=
#ADMIN_DEFAULT_PASSWORD_HASH=

# Nombre de proxys de confiance devant l'application (Render = 1).
# Sert à retrouver l'IP réelle du client pour le rate limiting.
TRUSTED_PROXY_COUNT=1
